# =============================================================================
# Переменные окружения для 1C Home Infrastructure
# =============================================================================
# Скопируйте этот файл в .env и измените значения при необходимости.
# docker-compose автоматически подхватит .env файл.
#
# ⚠️ ВАЖНО: Файл .env добавлен в .gitignore — никогда не коммитьте его!
# =============================================================================

# === PostgreSQL (СУБД для 1С) ===
DB_PASSWORD=your_password_here

# === pgAdmin (веб-интерфейс PostgreSQL) ===
PGADMIN_EMAIL=admin@example.ru
PGADMIN_PASSWORD=admin

# === Grafana (мониторинг и алерты) ===
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here

# === VoceChat (локальный мессенджер для уведомлений) ===
VOCECHAT_NOTIFY_PASSWORD=your_vocechat_notify_password_here

# === Email Fallback (резервные уведомления при падении VoceChat) ===
# Включите, когда настроите SMTP-сервер (Yandex, Gmail, Mail.ru и т.д.)
GF_SMTP_ENABLED=false
GF_SMTP_HOST=smtp.yandex.ru:465
GF_SMTP_USER=your-email@yandex.ru
GF_SMTP_PASSWORD=your-app-password
GF_SMTP_FROM_ADDRESS=grafana-alerts@yourdomain.ru